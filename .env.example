# Copy to .env and fill in — or export these variables in your shell.
# The server reads process env only; nothing here is ever sent to the browser
# except PAYPAL_CLIENT_ID (which is public by design in checkout pages).

# PayPal Sandbox app credentials (developer.paypal.com -> Apps & Credentials
# -> Sandbox). Leave BOTH empty to run in demo mode (simulated payments).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# OpenRouter API key for AI receipt extraction.
# If unset, the server tries OPENROUTER_KEY_FILE (default ~/.openrouter/key).
# If no key is available at all, extraction uses the built-in deterministic
# parser — the app keeps working, just without the LLM.
OPENROUTER_API_KEY=
OPENROUTER_KEY_FILE=

# Port (default 3000)
PORT=3000
